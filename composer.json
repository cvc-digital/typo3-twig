{
    "name": "cvc/typo3-twig",
    "description": "Use the Twig template engine within your TYPO3 project.",
    "license": "GPL-3.0-or-later",
    "type": "typo3-cms-extension",
    "authors": [
        {
            "name": "Lukas netz",
            "email": "netz@cvc.digital",
            "homepage": "https://cvc.digital",
            "role": "Developer"
        },
        {
            "name": "CARL von CHIARI GmbH",
            "email": "opensource@cvc.digital",
            "homepage": "https://cvc.digital",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://cvc.digital",
    "require": {
        "php": "^8.1",
        "twig/twig": "^3",
        "symfony/console": "^7.3",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-core": "^13.4.* || ^14.0",
        "typo3/cms-extbase": "^13.4.* || ^14.0",
        "typo3/cms-frontend": "^13.4.* || ^14.0"
    },
    "require-dev": {
        "cvc/twig-documentor": "^0.3",
        "ergebnis/composer-normalize": "^2.48",
        "friendsofphp/php-cs-fixer": "^3.92",
        "typo3/testing-framework": "^9.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/var-dumper": "^7.3"
    },
    "replace": {
        "typo3-ter/cvc_twig": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Cvc\\Typo3\\CvcTwig\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cvc\\Typo3\\CvcTwig\\Tests\\": "Tests",
            "TYPO3\\CMS\\Core\\Tests\\": ".Build/vendor/typo3/cms-core/Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "ergebnis/composer-normalize": true
        },
        "bin-dir": ".Build/bin",
        "vendor-dir": ".Build/vendor",
        "preferred-install": {
            "typo3/cms-core": "source"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        },
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "cvc_twig",
            "app-dir": ".Build",
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ]
    }
}
